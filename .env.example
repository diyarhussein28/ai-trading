# Copy to .env (never commit .env). On Railway, put these in Variables.
ANTHROPIC_API_KEY=
CLAUDE_VOTE_MODEL=claude-haiku-5-5
CLAUDE_REVIEW_MODEL=claude-opus-5-5

# Official X API v2 bearer token (optional). Without it, see social.on_missing in config/v7.yaml.
X_BEARER_TOKEN=

# Storage: leave empty for local SQLite (data/agents.db). Railway Postgres sets DATABASE_URL.
DATABASE_URL=

# Optional cross-check of mint/freeze authority straight from chain (Helius, QuickNode, ...)
SOLANA_RPC_URL=

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional: require ?token=... (or Authorization: Bearer ...) to view the dashboard API
DASHBOARD_TOKEN=

CONFIG_PATH=config/v7.yaml
PORT=8080
# Live trading is not implemented. This flag exists so it can never be switched on by accident.
ALLOW_LIVE=no
